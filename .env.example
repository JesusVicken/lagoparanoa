# URL do projeto Supabase (botão "Connect" no topo do painel → aba .env.local)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave pública "publishable" (sb_publishable_...) — mesmo painel "Connect".
# Projetos antigos: pode usar NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... no lugar.
# NUNCA use a chave secret / service_role aqui.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_sua-chave-aqui

# Nome do bucket público do Storage para as fotos
NEXT_PUBLIC_SUPABASE_BUCKET=escoamentos-fotos
